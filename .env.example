PORT=3000

# Comma-separated browser origins allowed to call the API (settl-web)
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

DATABASE_HOST=
DATABASE_PORT=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=

REDIS_HOST=
REDIS_PORT=

JWT_SECRET=<key>
JWT_EXPIRY=7d

# Global rate limit (in-memory). Auth login/register override to 5/min in code.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Group invite code validity in days (6-digit code)
INVITE_CODE_TTL_DAYS=7
